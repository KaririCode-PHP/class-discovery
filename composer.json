{
    "name": "kariricode/class-discovery",
    "description": "PHP 8.4+ class discovery component with attribute scanning, caching, and dependency analysis. Part of the KaririCode Framework ecosystem.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "class-discovery",
        "attributes",
        "reflection",
        "tokenizer",
        "psr-4",
        "kariricode"
    ],
    "homepage": "https://github.com/KaririCode-PHP/class-discovery",
    "support": {
        "issues": "https://github.com/KaririCode-PHP/class-discovery/issues",
        "source": "https://github.com/KaririCode-PHP/class-discovery"
    },
    "authors": [
        {
            "name": "Walmir Silva",
            "email": "walmir.silva@kariricode.org"
        }
    ],
    "require": {
        "php": "^8.4",
        "kariricode/contract": "^2.11",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "infection/infection": "^0.29",
        "nikic/php-parser": "^5.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5",
        "psr/simple-cache": "^3.0",
        "tomasvotruba/cognitive-complexity": "^1.0",
        "vimeo/psalm": "^6.0"
    },
    "suggest": {
        "kariricode/cache": "For PSR-16 cache integration via CacheBridge",
        "kariricode/configurator": "For environment-aware discovery configuration",
        "kariricode/dependency-injection": "For PSR-11 container integration",
        "psr/simple-cache": "For CacheBridge (any PSR-16 cache implementation)"
    },
    "autoload": {
        "psr-4": {
            "KaririCode\\ClassDiscovery\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KaririCode\\ClassDiscovery\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-conformance": "phpunit --testsuite Conformance",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "psalm": "psalm --no-cache",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "complexity": "php tools/complexity-budget.php src",
        "security": "composer audit --locked",
        "quality": [
            "@cs-check",
            "@phpstan",
            "@psalm",
            "@complexity",
            "@test",
            "@infection",
            "@security",
            "@sbom"
        ],
        "infection": "infection --threads=max",
        "sbom": "php tools/sbom.php"
    },
    "scripts-descriptions": {
        "test": "Unit, Integration and Conformance suites",
        "test-conformance": "Spec §29.2 + ARFA 1.3 conformance rules",
        "phpstan": "Level max, cognitive complexity <= 15 (Spec §13)",
        "psalm": "errorLevel 1 on src",
        "cs-check": "PER Coding Style",
        "complexity": "Cyclomatic <= 10, nesting <= 3, parameters <= 4 (Spec §13)",
        "security": "Known vulnerabilities in the locked dependency set (Spec §32)",
        "quality": "Full quality gate (Spec §29.1)",
        "infection": "Mutation testing, MSI >= 80% (Spec §29.1; needs pcov or xdebug)",
        "sbom": "CycloneDX 1.5 SBOM in build/sbom.cdx.json (Spec §32)"
    },
    "extra": {
        "kariricode": {
            "component": "class-discovery",
            "spec": "4.3.3",
            "arfa": {
                "version": "1.3",
                "level": 1
            },
            "asvs": {
                "version": "5.0",
                "level": 1
            },
            "error-code-range": "8700–8799"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "infection/extension-installer": false
        }
    }
}
